# Copy to .env at the repository root. Never commit real credentials.
# Atlas SRV example: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/comboroute?retryWrites=true&w=majority
# For local Docker Compose, see docker-compose.yml (MongoDB replica set required for transactions).
MONGODB_URI=mongodb://localhost:27017/comboroute?replicaSet=rs0&directConnection=true
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# For PUBLIC deployments, REQUIRE_DEMO_AUTH must be true and DEMO_PASSWORD set.
REQUIRE_DEMO_AUTH=false
DEMO_USER=demo
DEMO_PASSWORD=
# Only point tests at a disposable MongoDB instance/database.
TEST_MONGODB_URI=
