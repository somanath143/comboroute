# Copy to .env at the repository root. Never commit real credentials.
# Atlas SRV example: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/comboroute?retryWrites=true&w=majority
# For local Docker Compose, see docker-compose.yml (MongoDB replica set required for transactions).
MONGODB_URI=mongodb://localhost:27017/comboroute?replicaSet=rs0&directConnection=true
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set true only if you ALSO want an outer HTTP Basic Auth gate.
# New customer/restaurant/partner/admin accounts use cookie sessions instead.
REQUIRE_DEMO_AUTH=false
DEMO_USER=demo
DEMO_PASSWORD=

# Default: no payments. Use razorpay_test with Razorpay TEST credentials only.
# TEST keys must be issued by Razorpay (a matching pair); made-up placeholders cannot process payments.
# Restart the API after changing these values. Never expose secrets as VITE_* variables.
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Create staff accounts on first startup. Set these privately in Render Environment.
# Passwords must be >=12 characters. Existing staff passwords are not overwritten on redeploy.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_RESTAURANT_EMAIL=
BOOTSTRAP_RESTAURANT_PASSWORD=
BOOTSTRAP_RESTAURANT_RESTAURANT_IDS=1
BOOTSTRAP_PARTNER_EMAIL=
BOOTSTRAP_PARTNER_PASSWORD=

# Only point tests at a disposable MongoDB replica set/database.
TEST_MONGODB_URI=

# Integrated durable worker runs by default; set false if using npm run worker separately.
WORKER_ENABLED=true
# Reservations hold portions/prices for 10 minutes; pickup assignments last 5 minutes.
RESERVATION_TTL_MS=600000
ASSIGNMENT_LEASE_MS=300000

# New customer accounts require an emailed OTP. See docs/EMAIL_VERIFICATION.md.
# Generate a private random secret of at least 32 characters. Never expose these as VITE_*.
EMAIL_OTP_SECRET=
# Local SMTP remains the default. Render Free requires an HTTPS sender, such as brevo.
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Only for a local Mailpit test inbox; keep false for real email delivery.
SMTP_ALLOW_INSECURE_LOCAL=false
