# Copy to .env at the repository root. Never commit real credentials.
# Atlas SRV example: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/comboroute?retryWrites=true&w=majority
# For local Docker Compose, see docker-compose.yml (MongoDB replica set required for transactions).
MONGODB_URI=mongodb://localhost:27017/comboroute?replicaSet=rs0&directConnection=true
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set true only if you ALSO want an outer HTTP Basic Auth gate.
# New customer/restaurant/partner/admin accounts use cookie sessions instead.
REQUIRE_DEMO_AUTH=false
DEMO_USER=demo
DEMO_PASSWORD=

# Default: no payments. Use razorpay_test with Razorpay TEST credentials only.
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Create staff accounts on first startup. Set these privately in Render Environment.
# Passwords must be >=12 characters. Existing staff passwords are not overwritten on redeploy.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_RESTAURANT_EMAIL=
BOOTSTRAP_RESTAURANT_PASSWORD=
BOOTSTRAP_RESTAURANT_RESTAURANT_IDS=1
BOOTSTRAP_PARTNER_EMAIL=
BOOTSTRAP_PARTNER_PASSWORD=

# Only point tests at a disposable MongoDB replica set/database.
TEST_MONGODB_URI=
